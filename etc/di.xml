<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Framework\Event\ManagerInterface">
        <plugin name="st-trace-event"
                type="Goomento\SystemTraces\Plugin\Framework\Event\Manager" sortOrder="1"/>
    </type>

    <type name="Magento\Framework\Event\InvokerInterface">
        <plugin name="st-trace-observer"
                type="Goomento\SystemTraces\Plugin\Framework\Event\Invoker" sortOrder="1"/>
    </type>

    <type name="Magento\Framework\App\FrontControllerInterface">
        <plugin name="st-register-shutdown"
                type="Goomento\SystemTraces\Plugin\Framework\App\FrontController" sortOrder="0" />
    </type>

    <type name="Magento\Framework\App\Http">
        <plugin name="st-timeline-profiler"
                type="Goomento\SystemTraces\Plugin\App\Http" sortOrder="0" />
    </type>

    <type name="Magento\Framework\HTTP\ClientInterface">
        <plugin name="st-trace-http-client"
                type="Goomento\SystemTraces\Plugin\Framework\Http\Client" sortOrder="1" />
    </type>

    <type name="Magento\Framework\HTTP\Adapter\Curl">
        <plugin name="st-trace-http-adapter-curl"
                type="Goomento\SystemTraces\Plugin\Framework\Http\AdapterCurl" sortOrder="1" />
    </type>

    <type name="Zend_Db_Adapter_Abstract">
        <plugin name="st-db-adapter" type="Goomento\SystemTraces\Plugin\Zend\DbAdapter"/>
    </type>

    <virtualType name="Goomento\SystemTraces\Service\Collection" type="Goomento\SystemTraces\Service\Event\Instance">
        <arguments>
            <argument name="classType" xsi:type="string">collection</argument>
        </arguments>
    </virtualType>
    <virtualType name="Goomento\SystemTraces\Service\Model" type="Goomento\SystemTraces\Service\Event\Instance">
        <arguments>
            <argument name="classType" xsi:type="string">object</argument>
        </arguments>
    </virtualType>

    <type name="Goomento\SystemTraces\Plugin\Framework\Event\Manager">
        <arguments>
            <argument name="modelService" xsi:type="object">Goomento\SystemTraces\Service\Model</argument>
            <argument name="collectionService" xsi:type="object">Goomento\SystemTraces\Service\Collection</argument>
        </arguments>
    </type>

    <type name="Goomento\SystemTraces\Service\Timeline">
        <arguments>
            <argument name="modelService" xsi:type="object">Goomento\SystemTraces\Service\Model</argument>
            <argument name="collectionService" xsi:type="object">Goomento\SystemTraces\Service\Collection</argument>
        </arguments>
    </type>

</config>
