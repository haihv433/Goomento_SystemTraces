<?php
/**
 * Trace report body: summary bar + chronological waterfall.
 *
 * @var \Goomento\SystemTraces\Block\Report $block
 */
$summary = $block->getSummary();
$events = $block->getEvents();
$types = ['sql', 'api', 'timer', 'controller', 'event', 'model', 'collection', 'layout', 'observer'];
$typeColors = [
    'sql' => '#1d4ed8',
    'api' => '#9333ea',
    'timer' => '#9ca3af',
    'controller' => '#0891b2',
    'event' => '#64748b',
    'model' => '#16a34a',
    'collection' => '#ca8a04',
    'layout' => '#7c3aed',
    'observer' => '#db2777',
];
?>
<style>
#st-report {
    --st-bg: #FFFFFF;
    --st-th: #1d4ed8;
    --st-stripe: #f5f5f5;
    --st-hover: #eef4ff;
    --st-fg: #000000;
    --st-border: #CCCCCC;
    --st-link: #1d4ed8;
    --st-link-hover: #eb5202;

    box-sizing: border-box;
    background: var(--st-bg);
    text-align: left;
    font-family: Arial, "Helvetica Neue", Helvetica, "Segoe UI", freesans, sans-serif;
    font-size: 12px;
    color: var(--st-fg);
}

#st-report p {
    margin-bottom: 6px;
}

#st-report a {
    color: #006bb4;
    text-decoration: underline;
}

#st-report details.st-trace summary {
    cursor: pointer;
    color: var(--st-link);
    text-decoration: underline;
    text-decoration-style: dashed;
    list-style-position: inside;
}

#st-report details.st-trace summary:hover {
    color: var(--st-link-hover);
}

#st-report details.st-trace[open] summary {
    margin-bottom: 4px;
}

#st-report div.st-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 8px 10px;
    margin-bottom: 10px;
    background: var(--st-stripe);
    border: 1px solid var(--st-border);
}

#st-report div.st-summary strong {
    color: var(--st-th);
}

#st-report div.st-ruler {
    position: absolute;
    inset: 0;
    font-size: 10px;
    color: #666666;
}

#st-report div.st-ruler span {
    position: absolute;
    top: 0;
}

#st-report div.st-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    padding: 2px 0;
    border-bottom: 1px solid var(--st-border);
}

#st-report div.st-row.st-data:hover {
    background: var(--st-hover);
}

#st-report div.st-label {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 25%;
    max-width: 25%;
    font-size: 11px;
}

#st-report span.st-type {
    display: inline-block;
    flex: 0 0 auto;
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 9px;
    font-weight: bold;
    color: #ffffff;
    white-space: nowrap;
}

<?php foreach ($types as $type): ?>
#st-report div.st-bar.type-<?= $type ?>,
#st-report span.st-type.type-<?= $type ?> {
    background: <?= $typeColors[$type] ?>;
}
<?php endforeach; ?>

#st-report span.st-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    flex: 1 1 auto;
}

#st-report span.st-count {
    display: inline-block;
    flex: 0 0 auto;
    padding: 0 5px;
    border-radius: 8px;
    background: var(--st-stripe);
    font-size: 10px;
    font-weight: bold;
    white-space: nowrap;
}

#st-report div.st-track {
    position: relative;
    flex: 1 1 auto;
    height: 14px;
    background: var(--st-stripe);
}

#st-report div.st-time {
    flex: 0 0 70px;
    width: 70px;
    text-align: right;
    white-space: nowrap;
    font-size: 11px;
}

#st-report div.st-bar {
    position: absolute;
    top: 1px;
    height: 12px;
    min-width: 2px;
    border-radius: 2px;
}

#st-report div.st-bar.grade-bad {
    background: #dc2626;
}

#st-report div.st-bar.grade-medium {
    background: #eab308;
}

#st-report div.st-label details.st-trace {
    display: inline-block;
    flex: 0 0 auto;
}

#st-report div.st-label details.st-trace summary {
    list-style: none;
}

#st-report div.st-label details.st-trace summary::-webkit-details-marker {
    display: none;
}

#st-report div.st-label details.st-trace span.st-trace-body {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 5;
    margin-top: 2px;
    padding: 6px 8px;
    background: var(--st-bg);
    color: var(--st-fg);
    border: 1px solid var(--st-border);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    white-space: normal;
    word-break: break-word;
    font-size: 11px;
    font-family: monospace;
    user-select: text;
    cursor: text;
}
</style>
<div class="st-summary">
    <span><strong><?= __('Total time') ?>:</strong> <?= $block->formatMs($summary['total_duration'] ?? 0) ?></span>
    <span><strong><?= __('Peak memory') ?>:</strong> <?= $block->formatBytes($summary['peak_memory'] ?? 0) ?></span>
    <span><strong><?= __('SQL') ?>:</strong> <?= (int)($summary['sql_count'] ?? 0) ?> (<?= $block->formatMs($summary['sql_time'] ?? 0) ?>)</span>
    <span><strong><?= __('API calls') ?>:</strong> <?= (int)($summary['api_count'] ?? 0) ?> (<?= $block->formatMs($summary['api_time'] ?? 0) ?>)</span>
    <span><strong><?= __('Observers') ?>:</strong> <?= (int)($summary['observer_count'] ?? 0) ?></span>
    <span><strong><?= __('Framework timers') ?>:</strong> <?= (int)($summary['timer_count'] ?? 0) ?></span>
</div>
<?php if ($events): ?>
<div class="st-row st-ruler-row">
    <div class="st-label"></div>
    <div class="st-track">
        <div class="st-ruler">
            <span style="left:0%">0%</span>
            <span style="left:25%">25%</span>
            <span style="left:50%">50%</span>
            <span style="left:75%">75%</span>
            <span style="left:97%">100%</span>
        </div>
    </div>
    <div class="st-time"></div>
</div>
<?php foreach ($events as $event): ?>
    <?php $depth = (int)($event['depth'] ?? 0); ?>
    <div class="st-row st-data">
        <div class="st-label" style="margin-left:<?= $depth * 10 ?>px;">
            <span class="st-type type-<?= $block->escapeHtmlAttr($event['type']) ?>"><?= $block->escapeHtml(strtoupper($event['type'])) ?></span>
            <span class="st-text" title="<?= $block->escapeHtmlAttr($event['label']) ?>"><?= $block->escapeHtml($event['label']) ?></span>
            <?php if (!empty($event['count']) && $event['count'] > 1): ?>
                <span class="st-count" title="<?= $block->escapeHtmlAttr(__('Occurred %1 times, duration summed', $event['count'])) ?>">&times;<?= (int)$event['count'] ?></span>
            <?php endif; ?>
            <?php if (!empty($event['expandable_label'])): ?>
                <details class="st-trace"><summary title="<?= $block->escapeHtmlAttr(__('Show full text (selectable)')) ?>">&hellip;</summary><span class="st-trace-body"><?= $block->escapeHtml($event['expandable_label']) ?></span></details>
            <?php endif; ?>
            <?php if (!empty($event['context'])): ?>
                <details class="st-trace"><summary title="<?= $block->escapeHtmlAttr(__('Show full call path')) ?>">&hellip;</summary><span class="st-trace-body"><?= $block->escapeHtml($event['context']) ?></span></details>
            <?php endif; ?>
            <?php if (!empty($event['bt'])): ?>
                <?= $block->formatBt($event['bt']) ?>
            <?php endif; ?>
        </div>
        <div class="st-track">
            <?php foreach ($event['marks'] as $mark): ?>
                <div class="st-bar type-<?= $block->escapeHtmlAttr($event['type']) ?> grade-<?= $block->escapeHtmlAttr($event['grade']) ?>"
                     style="left:<?= round($mark['offset_pct'], 2) ?>%; width:<?= round($mark['width_pct'], 2) ?>%;"
                     title="<?= $block->escapeHtmlAttr($block->formatMs($mark['duration'])) ?>"></div>
            <?php endforeach; ?>
        </div>
        <div class="st-time"><?= $block->formatMs($event['duration']) ?></div>
    </div>
<?php endforeach; ?>
<?php else: ?>
<p><?= __('No timeline events recorded.') ?></p>
<?php endif; ?>
